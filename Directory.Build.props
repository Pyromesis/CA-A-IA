<Project>
  <!-- CA-A-IA · Propiedades comunes (Fase 0). Los .csproj solo declaran TargetFramework y PackageReferences. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>4</WarningLevel>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Convenciones de assembly: firma CA (Company) + producto CA-A-IA. -->
  <PropertyGroup>
    <Company>CA</Company>
    <Product>CA-A-IA</Product>
    <Copyright>Copyright © CA</Copyright>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <Version>0.1.4</Version>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
