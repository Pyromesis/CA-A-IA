<UserControl
    x:Class="CaAIA.Presentation.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <local:FileTreeItemGlyphConverter x:Key="TreeGlyph" />
        <local:FileTreeItemBrushConverter x:Key="TreeBrush" />
        <local:ZeroCountToVisibilityConverter x:Key="EmptyVisibility" />
        <local:NonZeroCountToVisibilityConverter x:Key="ListVisibility" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18"
                      Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.9"
                           FontFamily="Consolas" FontSize="12"
                           ToolTipService.ToolTip="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Actualizar" Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource AppGhostButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource FaintCaptionStyle}" FontSize="12" />
        <Grid Grid.Row="2">
            <Border Style="{StaticResource CardPanelStyle}" Padding="6"
                    Visibility="{x:Bind ViewModel.FileCount, Mode=OneWay, Converter={StaticResource ListVisibility}}">
                <TreeView ItemsSource="{x:Bind ViewModel.FileTree, Mode=OneWay}"
                          SelectionMode="None">
                    <TreeView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="True" />
                        </TransitionCollection>
                    </TreeView.ItemContainerTransitions>
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,5"
                                        ToolTipService.ToolTip="{Binding Content.FullPath}">
                                <FontIcon Glyph="{Binding Content, Converter={StaticResource TreeGlyph}}"
                                          FontSize="16"
                                          Foreground="{Binding Content, Converter={StaticResource TreeBrush}}"
                                          VerticalAlignment="Center" />
                                <StackPanel Spacing="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Content.Name}" FontSize="13"
                                               IsTextSelectionEnabled="True" />
                                    <TextBlock Text="{Binding Content.Meta}"
                                               Style="{StaticResource FaintCaptionStyle}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.FileCount, Mode=OneWay, Converter={StaticResource EmptyVisibility}}">
                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Carpeta vacía o sin acceso" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="Elige la carpeta del proyecto en el Chat y aquí verás lo que el agente puede leer."
                           Style="{StaticResource EmptyStateBodyStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
