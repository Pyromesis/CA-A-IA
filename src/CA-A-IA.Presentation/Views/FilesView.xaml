<UserControl
    x:Class="CaAIA.Presentation.Views.FilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <local:FileGlyphConverter x:Key="FileGlyph" />
        <local:ZeroCountToVisibilityConverter x:Key="EmptyVisibility" />
        <local:NonZeroCountToVisibilityConverter x:Key="ListVisibility" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18"
                      Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                <TextBlock Text="WORKSPACE" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.9"
                           FontFamily="Consolas" FontSize="12"
                           ToolTipService.ToolTip="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Actualizar" Command="{x:Bind ViewModel.RefreshCommand}"
                    Style="{StaticResource AppGhostButtonStyle}"
                    VerticalAlignment="Center" />
        </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource FaintCaptionStyle}" FontSize="12" />
        <Grid Grid.Row="2">
            <ListView ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Files.Count, Mode=OneWay, Converter={StaticResource ListVisibility}}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InteractiveCardStyle}" Padding="10,8"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="{Binding Converter={StaticResource FileGlyph}}"
                                          FontSize="16" Foreground="{ThemeResource AppInfoBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Files.Count, Mode=OneWay, Converter={StaticResource EmptyVisibility}}">
                <FontIcon Glyph="&#xE8B7;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Carpeta vacía o sin acceso" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="Elige la carpeta del proyecto en el Chat y aquí verás lo que el agente puede leer."
                           Style="{StaticResource EmptyStateBodyStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
