<UserControl
    x:Class="CaAIA.Presentation.Views.AutonomyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="10" Padding="16"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera: qué es + carpeta temporal de trabajo -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="14">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="22"
                          Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="AUTONOMÍA" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                    <TextBlock Text="Controlo tu PC como lo harías tú: ratón, teclado y comandos."
                               TextWrapping="WrapWholeWords" Opacity="0.9" />
                    <TextBlock Text="Atajos globales: Ctrl+J pausar · Ctrl+K reanudar (funcionan en cualquier app)."
                               FontSize="11" Opacity="0.6" TextWrapping="WrapWholeWords" />
                    <TextBlock Text="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11" Opacity="0.65"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conversación -->
        <ListView Grid.Row="1" x:Name="MessagesList"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource BubbleSelector}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>

        <!-- Actividad + controles ⏸/▶/⏹ -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" Width="16" Height="16"
                          IsActive="{x:Bind ViewModel.IsAgentWorking, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.AgentStatusVisibility, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AgentStatus, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"
                       Opacity="0.85" VerticalAlignment="Center" FontStyle="Italic"
                       Visibility="{x:Bind ViewModel.AgentStatusVisibility, Mode=OneWay}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                        VerticalAlignment="Center">
                <Button Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.PauseCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        AutomationProperties.Name="Pausar"
                        ToolTipService.ToolTip="Pausar (reanodable)"
                        Visibility="{x:Bind ViewModel.PauseButtonVisibility, Mode=OneWay}"
                        Padding="8,4" MinWidth="0" />
                <Button Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.ResumeCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        AutomationProperties.Name="Reanudar"
                        ToolTipService.ToolTip="Reanudar donde lo dejamos"
                        Visibility="{x:Bind ViewModel.ResumeButtonVisibility, Mode=OneWay}"
                        Padding="8,4" MinWidth="0" />
                <Button Content="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        AutomationProperties.Name="Detener"
                        ToolTipService.ToolTip="Detener del todo"
                        Visibility="{x:Bind ViewModel.StopButtonVisibility, Mode=OneWay}"
                        Padding="8,4" MinWidth="0" />
            </StackPanel>
        </Grid>

        <!-- Composer -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}" Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox"
                         AutomationProperties.Name="Instrucción"
                         Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Pide lo que sea: abre el navegador y busca… (Enter para enviar)"
                         CornerRadius="10" MinHeight="42" VerticalContentAlignment="Center"
                         BorderThickness="0" Background="Transparent"
                         KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="1" Content="Enviar →"
                        Command="{x:Bind ViewModel.SendCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="110" MinHeight="42" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
