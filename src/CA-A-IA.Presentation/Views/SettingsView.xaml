<UserControl
    x:Class="CaAIA.Presentation.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
            <StackPanel Spacing="1">
                <TextBlock Text="AJUSTES" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="Claves de API" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Se guardan cifradas en el Credential Manager de Windows. Sin key, los modelos de pago y la mayoría de gratis no responden."
                           Style="{StaticResource MutedBodyStyle}" FontSize="13" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock Text="Probando conexión…" Opacity="0.7"
                           Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>

            <Border Style="{StaticResource CardPanelStyle}" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="OPENCODE ZEN" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="OpenCode Zen" Style="{StaticResource CardTitleStyle}" FontSize="16" />
                <TextBlock Text="Consigue tu key en opencode.ai/auth (los modelos gratis también la piden)."
                           Style="{StaticResource MutedBodyStyle}" FontSize="13" />
                <PasswordBox Header="OPENCODE_ZEN_API_KEY"
                             Password="{x:Bind ViewModel.ZenKey, Mode=TwoWay}"
                             PlaceholderText="Pega aquí tu key…" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Guardar" Command="{x:Bind ViewModel.SaveZenCommand}"
                            Style="{StaticResource AppPrimaryButtonStyle}" />
                    <Button Content="Probar con big-pickle (gratis)"
                            Command="{x:Bind ViewModel.TestZenCommand}"
                            Style="{StaticResource AppGhostButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ZenStatus, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" Opacity="0.85" />
            </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelStyle}" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="OPENCODE LOCAL" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="OpenCode local (tier gratis con login)"
                           Style="{StaticResource CardTitleStyle}" FontSize="16" />
                <TextBlock Text="Los modelos gratis de OpenCode solo funcionan dentro de OpenCode logueado: instala el CLI ('npm install -g opencode-ai'), haz 'opencode auth login' y elige el proveedor OpenCode en el Chat."
                           Style="{StaticResource MutedBodyStyle}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Detectar OpenCode" Command="{x:Bind ViewModel.TestOpencodeCommand}"
                            Style="{StaticResource AppGhostButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.OpencodeStatus, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" Opacity="0.85" />
            </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelStyle}" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="SIN CUENTAS NI KEYS" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="Modelos locales (gratis)"
                           Style="{StaticResource CardTitleStyle}" FontSize="16" />
                <TextBlock Text="Si tienes Ollama (ollama serve + algún modelo con ollama pull) o LM Studio con su servidor local arrancado, la app los detecta sola y funcionan sin internet ni claves."
                           Style="{StaticResource MutedBodyStyle}" FontSize="13" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Detectar" Command="{x:Bind ViewModel.TestLocalCommand}"
                            Style="{StaticResource AppGhostButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.LocalStatus, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" Opacity="0.85" />
            </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanelStyle}" Padding="14">
            <StackPanel Spacing="8">
                <TextBlock Text="OPENROUTER" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                <TextBlock Text="OpenRouter" Style="{StaticResource CardTitleStyle}" FontSize="16" />
                <TextBlock Text="Consigue tu key en openrouter.ai/keys (hay modelos con sufijo :free)."
                           Style="{StaticResource MutedBodyStyle}" FontSize="13" />
                <PasswordBox Header="OPENROUTER_API_KEY"
                             Password="{x:Bind ViewModel.RouterKey, Mode=TwoWay}"
                             PlaceholderText="Pega aquí tu key…" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Guardar" Command="{x:Bind ViewModel.SaveRouterCommand}"
                            Style="{StaticResource AppPrimaryButtonStyle}" />
                    <Button Content="Probar con un gratis"
                            Command="{x:Bind ViewModel.TestRouterCommand}"
                            Style="{StaticResource AppGhostButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.RouterStatus, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" Opacity="0.85" />
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
