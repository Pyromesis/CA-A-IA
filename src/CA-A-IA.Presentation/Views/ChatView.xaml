<UserControl
    x:Class="CaAIA.Presentation.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="UserBubble">
            <Grid HorizontalAlignment="Stretch">
                <Border HorizontalAlignment="Right" MaxWidth="720"
                        Background="{ThemeResource AppBrandBrush}"
                        CornerRadius="16,16,4,16" Padding="14,10">
                    <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppBrandInk}" Opacity="0.75" />
                            <TextBlock Text="{Binding TimeLabel}" FontSize="11"
                                       Foreground="{ThemeResource AppBrandInk}" Opacity="0.55" />
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords"
                                   IsTextSelectionEnabled="True" FontWeight="Medium"
                                   Foreground="{ThemeResource AppBrandInk}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AgentBubble">
            <Grid HorizontalAlignment="Stretch">
                <Border HorizontalAlignment="Left" MaxWidth="720"
                        Background="{ThemeResource AppCardBackground}"
                        BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1"
                        CornerRadius="16,16,16,4" Padding="12,10">
                    <!-- Grid (no StackPanel horizontal): el StackPanel mide a sus hijos
                         con ancho infinito y el texto salía en una sola línea cortada.
                         Con columna * el texto se acota y envuelve completo. -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Width="4" RadiusX="2" RadiusY="2" Margin="0,2"
                                   Fill="{ThemeResource AppBrandBrush}"
                                   VerticalAlignment="Stretch" />
                        <StackPanel Grid.Column="1" Spacing="3" MinWidth="120">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding RoleLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppBrandBrush}" Opacity="1" />
                                <TextBlock Text="{Binding TimeLabel}" FontSize="11" Opacity="0.55" />
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" TextWrapping="WrapWholeWords"
                                       IsTextSelectionEnabled="True" LineHeight="22" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SystemBubble">
            <Grid HorizontalAlignment="Stretch" ColumnSpacing="10" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" Height="1" Fill="{ThemeResource AppCardBorder}"
                           VerticalAlignment="Center" Opacity="0.8" />
                <Border Grid.Column="1" CornerRadius="10" Padding="12,4"
                        Background="{ThemeResource AppPageBackgroundAlt}"
                        BorderBrush="{ThemeResource AppCardBorder}" BorderThickness="1">
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center"
                               MaxWidth="700" FontSize="11" FontWeight="SemiBold" Opacity="0.75"
                               CharacterSpacing="60" TextWrapping="WrapWholeWords"
                               IsTextSelectionEnabled="True" Foreground="{ThemeResource AppMutedText}"
                               Text="{Binding Text}" />
                </Border>
                <Rectangle Grid.Column="2" Height="1" Fill="{ThemeResource AppCardBorder}"
                           VerticalAlignment="Center" Opacity="0.8" />
            </Grid>
        </DataTemplate>
        <local:ChatBubbleSelector x:Key="BubbleSelector"
                                  UserTemplate="{StaticResource UserBubble}"
                                  AgentTemplate="{StaticResource AgentBubble}"
                                  SystemTemplate="{StaticResource SystemBubble}" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera de sesión: contexto + configuración del modelo -->
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="14">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18"
                          Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="CARPETA DEL PROYECTO" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                    <TextBlock Text="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.9"
                               FontFamily="Consolas" FontSize="12"
                               ToolTipService.ToolTip="{x:Bind ViewModel.WorkspacePath, Mode=OneWay}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Carpeta…" Click="PickFolderButton_Click"
                        Style="{StaticResource AppGhostButtonStyle}"
                        ToolTipService.ToolTip="Seleccionar la carpeta del proyecto" />
                <Button Grid.Column="3" Content="Nueva conversación" Command="{x:Bind ViewModel.NewConversationCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        ToolTipService.ToolTip="Separa la conversación actual; el historial se conserva" />
            </Grid>
            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Header="Proveedor"
                          AutomationProperties.Name="Proveedor"
                          ItemsSource="{x:Bind ViewModel.AvailableProviders, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                          DisplayMemberPath="Display" MinWidth="150" MaxDropDownHeight="380" />
                <ComboBox Grid.Column="1" Header="Modelo"
                          AutomationProperties.Name="Modelo"
                          ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}"
                          DisplayMemberPath="Display" MinWidth="220" MaxWidth="320" MaxDropDownHeight="380" />
                <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                        Command="{x:Bind ViewModel.LoadModelsCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        AutomationProperties.Name="Recargar modelos"
                        ToolTipService.ToolTip="Recargar modelos del proveedor"
                        VerticalAlignment="Bottom" Margin="0,0,0,1" />
                <CheckBox Grid.Column="3" Content="Gratis"
                          IsChecked="{x:Bind ViewModel.ShowFreeOnly, Mode=TwoWay}"
                          ToolTipService.ToolTip="Mostrar solo modelos gratuitos"
                          VerticalAlignment="Bottom" Margin="0,0,0,5" />
                <ComboBox Grid.Column="4" Header="Esfuerzo"
                          AutomationProperties.Name="Esfuerzo"
                          ItemsSource="{x:Bind ViewModel.AvailableEfforts, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedEffort, Mode=TwoWay}"
                          DisplayMemberPath="Display" MinWidth="110"
                          ToolTipService.ToolTip="Nivel de razonamiento (OpenCode: variant)" />
                <ComboBox Grid.Column="5" Header="Autorización"
                          AutomationProperties.Name="Autorización"
                          ItemsSource="{x:Bind ViewModel.AvailableAuthLevels, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedAuthLevel, Mode=TwoWay}"
                          DisplayMemberPath="Display" MinWidth="210"
                          ToolTipService.ToolTip="Nivel 1: pide permiso por cambio. Nivel 2: edita sin pedir, sin controlar el PC. Nivel 3: control total sin pedir." />
            </Grid>
        </Grid>
        </Border>

        <!-- Historial -->
        <ListView Grid.Row="1" x:Name="MessagesList"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                  ItemTemplateSelector="{StaticResource BubbleSelector}"
                  SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,4" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
        </ListView>

        <!-- Actividad del agente -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressRing Grid.Column="0" Width="16" Height="16"
                          IsActive="{x:Bind ViewModel.IsAgentWorking, Mode=OneWay}"
                          Visibility="{x:Bind ViewModel.AgentStatusVisibility, Mode=OneWay}" />
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.AgentStatus, Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite"
                       Opacity="0.85" VerticalAlignment="Center" FontStyle="Italic"
                       Visibility="{x:Bind ViewModel.AgentStatusVisibility, Mode=OneWay}" />
            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ModelsStatus, Mode=OneWay}"
                       Opacity="0.65" FontSize="12" VerticalAlignment="Center" />
        </Grid>

        <!-- Composer -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}" Padding="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox"
                         AutomationProperties.Name="Mensaje"
                         Text="{x:Bind ViewModel.Input, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Describe tu objetivo… (Enter para enviar)"
                         CornerRadius="10" MinHeight="42" VerticalContentAlignment="Center"
                         BorderThickness="0" Background="Transparent"
                         KeyDown="InputBox_KeyDown" />
                <Button Grid.Column="1" Content="Enviar →"
                        Command="{x:Bind ViewModel.SendCommand}"
                        Style="{StaticResource AppPrimaryButtonStyle}" MinWidth="110" MinHeight="42" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
