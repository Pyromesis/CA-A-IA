<UserControl
    x:Class="CaAIA.Presentation.Views.OutputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <local:ZeroCountToVisibilityConverter x:Key="EmptyVisibility" />
        <local:NonZeroCountToVisibilityConverter x:Key="ListVisibility" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="18"
                          Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="DIARIO DE EJECUCIÓN" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
                    <TextBlock Opacity="0.8" FontSize="12">
                        <Run Text="Eventos en vivo · " />
                        <Run Text="{x:Bind ViewModel.Lines.Count, Mode=OneWay}" />
                        <Run Text=" líneas" />
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AppSuccessBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="EN VIVO" FontSize="11" FontWeight="SemiBold" Opacity="0.85" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardPanelStyle}" Padding="8"
                    Visibility="{x:Bind ViewModel.Lines.Count, Mode=OneWay, Converter={StaticResource ListVisibility}}">
                <ListView ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                          SelectionMode="None" FontFamily="Consolas" FontSize="12" />
            </Border>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Lines.Count, Mode=OneWay, Converter={StaticResource EmptyVisibility}}">
                <FontIcon Glyph="&#xE756;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Todo en calma" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="Cuando ejecutes un plan, cada paso del agente quedará registrado aquí."
                           Style="{StaticResource EmptyStateBodyStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
