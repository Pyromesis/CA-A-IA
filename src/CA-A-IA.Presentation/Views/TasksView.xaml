<UserControl
    x:Class="CaAIA.Presentation.Views.TasksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <local:StatusBrushConverter x:Key="StatusBrush" />
        <local:ZeroCountToVisibilityConverter x:Key="EmptyVisibility" />
        <local:NonZeroCountToVisibilityConverter x:Key="ListVisibility" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="1">
            <TextBlock Text="SEGUIMIENTO" Style="{StaticResource EyebrowLabelStyle}" FontSize="10" />
            <TextBlock Text="Tareas del plan" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <ListView ItemsSource="{x:Bind ViewModel.Tasks, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Tasks.Count, Mode=OneWay, Converter={StaticResource ListVisibility}}"
                      SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InteractiveCardStyle}"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                         Fill="{Binding Status, Converter={StaticResource StatusBrush}}"
                                         VerticalAlignment="Top" Margin="0,5,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                                    <Border Style="{StaticResource StatusPillStyle}"
                                            HorizontalAlignment="Left" Padding="8,1">
                                        <TextBlock Text="{Binding Status}" FontSize="11"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Tasks.Count, Mode=OneWay, Converter={StaticResource EmptyVisibility}}">
                <FontIcon Glyph="&#xE9F5;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Nada en marcha" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="Las tareas del plan activo aparecerán aquí con su estado en tiempo real."
                           Style="{StaticResource EmptyStateBodyStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
