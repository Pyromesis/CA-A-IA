<UserControl
    x:Class="CaAIA.Presentation.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CaAIA.Presentation.Views">
    <UserControl.Resources>
        <local:ZeroCountToVisibilityConverter x:Key="EmptyVisibility" />
        <local:NonZeroCountToVisibilityConverter x:Key="ListVisibility" />
    </UserControl.Resources>
    <Grid RowSpacing="10" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardPanelStyle}" Padding="12">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="18"
                          Foreground="{ThemeResource AppBrandBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite"
                           Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="Actualizar" Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{StaticResource AppGhostButtonStyle}" />
                <Button Grid.Column="3" Content="Conversación actual"
                        Command="{x:Bind ViewModel.OpenLiveCommand}"
                        Style="{StaticResource AppGhostButtonStyle}"
                        ToolTipService.ToolTip="Volver a la conversación en vivo" />
            </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="Toca una conversación para abrirla en el Chat."
                   Style="{StaticResource FaintCaptionStyle}" FontSize="12" />
        <Grid Grid.Row="2">
            <ListView x:Name="ConversationList"
                      ItemsSource="{x:Bind ViewModel.Conversations, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.Conversations.Count, Mode=OneWay, Converter={StaticResource ListVisibility}}"
                      SelectionMode="Single"
                      SelectionChanged="ConversationList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource InteractiveCardStyle}"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A5;" FontSize="20"
                                          Foreground="{ThemeResource AppMutedText}"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource FaintCaptionStyle}" />
                                    <TextBlock Text="{Binding Preview}" Opacity="0.85" FontSize="12"
                                               TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis"
                                               MaxLines="2" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14"
                                          Foreground="{ThemeResource AppFaintText}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Conversations.Count, Mode=OneWay, Converter={StaticResource EmptyVisibility}}">
                <FontIcon Glyph="&#xE81C;" Style="{StaticResource EmptyStateIconStyle}" />
                <TextBlock Text="Aún no hay conversaciones" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="Cuando hables con el agente, tus conversaciones aparecerán aquí para retomarlas cuando quieras."
                           Style="{StaticResource EmptyStateBodyStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
